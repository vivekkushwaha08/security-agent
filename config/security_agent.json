{
  "app": {"name": "Security Agent", "environment": "development", "log_level": "INFO"},
  "webhook": {"enabled": true, "provider": "bitbucket", "secret_env": "BITBUCKET_WEBHOOK_SECRET", "allowed_repositories": [], "require_signature": true},
  "git": {"workspace_root": "./workspaces", "allowed_hosts": ["bitbucket.org"], "fetch_depth": 1, "checkout_timeout_seconds": 120},
  "ai": {"enabled": false, "provider": "claude", "model": "claude-sonnet-4-5", "timeout_seconds": 180, "max_input_chars": 120000, "api_key_env": "ANTHROPIC_API_KEY", "cli_command": "claude"},
  "scanners": {
    "semgrep": {"enabled": true, "command": "semgrep", "args": ["scan", "--config", "auto", "--json"]},
    "osv": {"enabled": true, "command": "osv-scanner", "args": ["scan", "source", "--format", "json"]},
    "trivy": {"enabled": true, "command": "trivy", "args": ["fs", "--format", "json"]},
    "gitleaks": {"enabled": true, "command": "gitleaks", "args": ["dir", "--report-format", "json"]}
  },
  "analysis": {"check_cwe": true, "check_eol": true, "fail_on": "high", "max_repository_mb": 500},
  "workers": {"backend": "local", "redis_url_env": "REDIS_URL", "max_concurrency": 2, "job_timeout_seconds": 900},
  "reporting": {"formats": ["json", "sarif"], "output_dir": "./reports", "retain_days": 30}
}
